// Sandhata Design System — Prisma schema
// NextAuth required tables + builder sessions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── NextAuth tables ──────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  apiKeyEnc      String?   @db.Text // Anthropic API key, AES-256-GCM encrypted (see lib/crypto.ts) — never stored or returned as plaintext
  accounts       Account[]
  sessions       Session[]
  builderSessions BuilderSession[]
  projects        Project[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Builder projects ──────────────────────────────────────────────────────────
// A project is a folder grouping multiple BuilderSessions (pages/functions)
// so a user can organize and switch between related work-in-progress pieces
// instead of one flat, ungrouped session list. v1 scope: organize + quick
// switch — no simultaneous multi-pane editing (see HANDOFF.md §9).

model Project {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sessions  BuilderSession[]

  @@index([userId, updatedAt])
}

// ── Builder sessions ─────────────────────────────────────────────────────────

model BuilderSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable: a session doesn't have to belong to a project (existing
  // pre-Projects sessions stay ungrouped rather than orphaned/migrated).
  // Cascade: deleting a project's "folder" deletes the pages inside it,
  // matching the folder metaphor — not a soft unlink.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String   // First user message used as title
  messages  Json     // ChatMsg[]
  tree      Json?    // Latest UINode tree
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
}
