// Sandhata Design System — Prisma schema
// NextAuth required tables + builder sessions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── NextAuth tables ──────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  apiKeyEnc      String?   @db.Text // Anthropic API key, AES-256-GCM encrypted (see lib/crypto.ts) — never stored or returned as plaintext
  accounts       Account[]
  sessions       Session[]
  builderSessions BuilderSession[]
  projects        Project[]
  githubInstallations GitHubInstallation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Builder projects ──────────────────────────────────────────────────────────
// A project is a folder grouping multiple BuilderSessions (pages/functions)
// so a user can organize and switch between related work-in-progress pieces
// instead of one flat, ungrouped session list. v1 scope: organize + quick
// switch — no simultaneous multi-pane editing (see HANDOFF.md §9).

model Project {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sessions  BuilderSession[]

  // ── GitHub push integration (Phase 1: push-only, single repo) ───────────
  // All optional — a project has no GitHub connection until /api/github/connect
  // is called. SetNull (not Cascade) on the installation FK: uninstalling/
  // deleting a GitHubInstallation row shouldn't delete the project it was
  // pushing to, just leave it disconnected (repoOwner/repoName stay as a
  // record of where it last pointed, syncStatus reflects the break).
  githubInstallationId String?
  githubInstallation   GitHubInstallation? @relation(fields: [githubInstallationId], references: [id], onDelete: SetNull)
  repoOwner            String?
  repoName             String?
  defaultBranch        String?
  // The branch we actually push to (sandhata/<project-slug>), created off
  // the repo's default branch on first connect — never pushed straight to
  // defaultBranch. See lib/github.ts / app/api/github/push.
  workingBranch         String?
  lastSyncedSha         String?
  lastSyncedAt          DateTime?
  // "idle" | "syncing" | "synced" | "error" — set by /api/github/push;
  // "error" pairs with lastSyncError holding the human-readable reason.
  syncStatus            String?
  lastSyncError         String?  @db.Text

  @@index([userId, updatedAt])
  @@unique([repoOwner, repoName, userId])
}

// One GitHub App installation (an org or user account that installed the
// Sandhata GitHub App), linked to whichever Sandhata user completed that
// install flow. installationId is the source of truth for minting a scoped
// access token (see lib/github.ts) — accountLogin/accountType are cached
// display-only fields so the repo picker doesn't need a live API call just
// to label "installed on: <account>".
model GitHubInstallation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId Int      @unique
  accountLogin   String
  accountType    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  projects       Project[]

  @@index([userId])
}

// ── Builder sessions ─────────────────────────────────────────────────────────

model BuilderSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable: a session doesn't have to belong to a project (existing
  // pre-Projects sessions stay ungrouped rather than orphaned/migrated).
  // Cascade: deleting a project's "folder" deletes the pages inside it,
  // matching the folder metaphor — not a soft unlink.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String   // First user message used as title
  messages  Json     // ChatMsg[]
  tree      Json?    // Latest UINode tree
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
}
