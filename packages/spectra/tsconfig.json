{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "./dist/types",
    "noEmit": false,
    "outDir": "./dist"
  },
  "include": ["src/**/*.jsx", "src/**/*.js", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
