# Anthropic API key for the AI interface builder (/builder).
# Get one at https://console.anthropic.com/ then restart: npm run dev
# Deliberately left unset on Vercel — the hosted builder asks visitors for their own key instead.
ANTHROPIC_API_KEY=

# Postgres connection string (NextAuth + builder session/account storage).
DATABASE_URL=

# NextAuth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Symmetric key used to encrypt account-linked Anthropic API keys at rest (lib/crypto.ts).
# Any random string, e.g.: openssl rand -hex 32
BUILDER_KEY_SECRET=
