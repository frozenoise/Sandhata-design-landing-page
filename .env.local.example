# Anthropic API key for the AI interface builder (/builder).
# Get one at https://console.anthropic.com/ then restart: npm run dev
# Deliberately left unset on Vercel — the hosted builder asks visitors for their own key instead.
ANTHROPIC_API_KEY=

# Postgres connection string (NextAuth + builder session/account storage).
DATABASE_URL=

# NextAuth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Symmetric key used to encrypt account-linked Anthropic API keys at rest (lib/crypto.ts).
# Also used to HMAC-sign the /api/github/install CSRF state param (lib/github.ts).
# Any random string, e.g.: openssl rand -hex 32
BUILDER_KEY_SECRET=

# GitHub App — powers the /builder → GitHub repo push integration (lib/github.ts,
# app/api/github/**). This is a SEPARATE credential from AUTH_GITHUB_ID/SECRET
# above (which is login-only OAuth, no repo scope — do not reuse it here).
# Until all of these are set, every app/api/github/** route returns
# { error: "github_app_not_configured" } instead of erroring, and the
# builder's "Connect GitHub" UI shows a "not set up yet" state.
#
# Register the App at https://github.com/settings/apps/new with:
#   - Repository permissions → Contents: Read & write, Metadata: Read-only
#   - Callback URL: <your deployment URL>/api/github/install/callback
#   - Webhook: not required for Phase 1 (uncheck "Active" to skip webhook setup)
# After creating it:
#   - GITHUB_APP_ID: the numeric "App ID" on the app's settings page
#   - GITHUB_APP_SLUG: the app's URL slug (github.com/apps/<slug>)
#   - GITHUB_APP_PRIVATE_KEY: "Generate a private key" → downloads a .pem file;
#     paste its contents here with literal "\n" for newlines (one env-var line)
#   - GITHUB_APP_CLIENT_ID / GITHUB_APP_CLIENT_SECRET: from the same settings
#     page ("Generate a new client secret") — not used by Phase 1's push flow,
#     but read by lib/github.ts if present; safe to leave blank for now.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
